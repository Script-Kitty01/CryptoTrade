generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WatchlistItem {
  id        String   @id @default(cuid())
  coinId    String
  coinName  String
  coinSymbol String  @default("")
  coinImage String   @default("")
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([coinId])
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  coinId      String
  coinName    String
  coinSymbol  String   @default("")
  coinImage   String   @default("")
  quantity    Float
  buyPriceUsd Float
  buyDate     DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceAlert {
  id          String   @id @default(cuid())
  coinId      String
  coinName    String
  coinSymbol  String   @default("")
  targetPrice Float
  direction   String   // "above" | "below"
  triggered   Boolean  @default(false)
  triggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
